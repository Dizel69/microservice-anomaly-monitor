.ruff_cache/

# IDE
.vscode/
.idea/

# Системные файлы
.DS_Store

# Личные документы (отчёты НИР) — не в публичный репозиторий
*.docx

# ---------------------------------------------------------------------------
# Данные: в git кладём ИСХОДНИКИ, которые можно скачать с GitHub.
# GitHub не принимает файлы > 100 МБ — поэтому:
#   - KPI: в репозитории phase2_train.csv.gz (~16 МБ), не сырой .csv (176 МБ)
#   - unified/processed: пересобираются конвейером, в git не кладём
# ---------------------------------------------------------------------------
datasets/processed/**
!datasets/processed/**/
!datasets/processed/**/.gitkeep

datasets/unified/**
!datasets/unified/**/
!datasets/unified/**/.gitkeep

# Служебные parquet, которые ETL кладёт рядом с исходниками
datasets/raw/**/*.parquet
# Свои выгрузки Prometheus — маленькие, оставляем в git
!datasets/raw/PROMETHEUS/*.parquet

# Несжатый KPI превышает лимит GitHub
datasets/raw/KPI/phase2_train.csv

# Демо-GUI: выбор режима Prometheus и логи прогонов — локальные, не в git
gui/state.json
gui/logs/*.log
