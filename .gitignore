# IDE
.vscode/
.idea/

# Системные файлы
.DS_Store

# Личный контекст агента-менеджера (история проекта, не в публичный репозиторий)
AGENT_CONTEXT.md

# Личные документы (отчёты НИР / промежуточные Word) — не в публичный репозиторий
# Первый отчёт: docs/reports/01_первый_отчёт.docx
*.docx

# ---------------------------------------------------------------------------
# Данные: в git кладём ИСХОДНИКИ, которые можно скачать с GitHub.
# GitHub не принимает файлы > 100 МБ — поэтому:
#   - KPI: в репозитории phase2_train.csv.gz (~16 МБ), не сырой .csv (176 МБ)
#   - unified/processed: пересобираются конвейером, в git не кладём
# ---------------------------------------------------------------------------
datasets/processed/**
!datasets/processed/**/
!datasets/processed/**/.gitkeep

datasets/unified/**
!datasets/unified/**/
!datasets/unified/**/.gitkeep

# Служебные parquet, которые ETL кладёт рядом с исходниками
datasets/raw/**/*.parquet
# Свои выгрузки Prometheus — маленькие, оставляем в git
!datasets/raw/PROMETHEUS/*.parquet

# Несжатый KPI превышает лимит GitHub
datasets/raw/KPI/phase2_train.csv

# Демо-GUI: выбор режима Prometheus и логи прогонов — локальные, не в git
gui/state.json
gui/logs/*.log

# Рабочие выгрузки Zabbix / большой live-Prometheus — не в публичный GitHub
# (маленькие демо-дампы PROMETHEUS/*.parquet по-прежнему в git)
datasets/raw/ZABBIX/**
!datasets/raw/ZABBIX/.gitkeep
datasets/raw/PROMETHEUS/live/**
!datasets/raw/PROMETHEUS/live/.gitkeep

# Сборка LaTeX (исходники docs/thesis/*.tex в git; PDF по желанию)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.nav
*.snm
*.vrb
*.xdv
docs/thesis/_build/
