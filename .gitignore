# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Виртуальные окружения
.venv/
venv/
env/
ENV/

# Тесты / покрытие
.pytest_cache/
.coverage
htmlcov/
